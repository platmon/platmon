#!/bin/sh
set -eu
case "$1" in
    configure)
        # Validate the preserved config before enabling or restarting any service: config-check exits 1
        # for a file it refuses, with the reason on stderr after "error: ".
        status=0
        why=$(/usr/lib/platmon/platmon-server config-check /etc/platmon/platmon.ini 2>&1 >/dev/null) || status=$?
        if [ "$status" -eq 1 ]; then
            echo "invalid platmon config: ${why#*error: }" >&2
            exit 1
        elif [ "$status" -ne 0 ]; then
            echo "platmon config check failed (exit $status): $why" >&2
            exit 1
        fi
        deb-systemd-helper unmask platmon.service >/dev/null || true
        if deb-systemd-helper --quiet was-enabled platmon.service; then
            deb-systemd-helper enable platmon.service >/dev/null || true
        else
            deb-systemd-helper update-state platmon.service >/dev/null || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload
            if [ -n "${2:-}" ]; then
                deb-systemd-invoke restart platmon.service
            else
                deb-systemd-invoke start platmon.service
            fi
            # A service that was started must stay running and answer /api/stats on the configured address
            # (`platmon-server health`: a current snapshot, as /api/status says ready) within 20 s.
            # Failing here leaves the package unconfigured; installing the previous package recovers.
            state() { systemctl show platmon.service -p "$1" --value; }
            if [ "$(state ActiveState)" = inactive ] && [ "$(state Result)" = success ]; then
                echo "platmon.service is not started (disabled, masked or held by policy); health check skipped"
            else
                restarts=$(state NRestarts) why="no answer" healthy=false
                deadline=$(($(date +%s) + 20))
                while [ "$(date +%s)" -lt "$deadline" ]; do
                    if [ "$(state ActiveState)" != active ] || [ "$(state NRestarts)" != "$restarts" ]; then
                        why="the service stopped ($(state ActiveState)/$(state SubState), result $(state Result))"
                        break
                    fi
                    if why=$(/usr/lib/platmon/platmon-server health /etc/platmon/platmon.ini 2>&1 >/dev/null); then
                        healthy=true
                        break
                    fi
                    sleep 0.5
                done
                if [ "$healthy" != true ]; then
                    echo "platmon.service failed its health check: ${why#platmon-server health: }; see journalctl -u platmon." \
                        "To go back, install the previous package: sudo apt install --allow-downgrades platmon=VERSION" >&2
                    exit 1
                fi
            fi
        fi
        ;;
esac
exit 0
