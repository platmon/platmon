# The platmon command and the tray are built static on purpose (musl, no shared libraries), as the server is, so one
# package runs on every supported distribution release; copyright lists what they include.
platmon-frontend [arm64 armhf]: statically-linked-binary [usr/bin/platmon]
platmon-frontend [arm64 armhf]: statically-linked-binary [usr/bin/platmon-tray]
# The amd64 build is a static PIE: an ELF of type DYN without shared libraries, not a shared library.
platmon-frontend [amd64]: shared-library-lacks-prerequisites [usr/bin/platmon]
platmon-frontend [amd64]: shared-library-lacks-prerequisites [usr/bin/platmon-tray]
