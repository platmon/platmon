# platmon candidate check: the login user may start, stop, restart and kill the two candidate units and
# read their resources; nothing else. Removed by uninstall.sh. platmon.service is not named here.
@USER@ ALL=(root) NOPASSWD: \
  /usr/bin/systemctl start platmon-server-candidate.service, \
  /usr/bin/systemctl stop platmon-server-candidate.service, \
  /usr/bin/systemctl restart platmon-server-candidate.service, \
  /usr/bin/systemctl kill --signal=SIGKILL platmon-server-candidate.service, \
  /usr/bin/systemctl start platmon-server-candidate-fakesmi.service, \
  /usr/bin/systemctl stop platmon-server-candidate-fakesmi.service, \
  /usr/bin/systemctl restart platmon-server-candidate-fakesmi.service, \
  /usr/bin/systemctl reset-failed platmon-server-candidate.service platmon-server-candidate-fakesmi.service, \
  /usr/lib/platmon-candidate/measure ""
