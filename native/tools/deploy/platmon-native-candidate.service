# platmon candidate check: platmon-native candidate 1 (native/CANDIDATE.md) on the candidate's INI and port.
# Beside platmon.service, never in its place; not enabled. Hardening as the product unit.
[Unit]
Description=platmon candidate check: platmon-native
After=network.target
Conflicts=platmon-python-candidate.service platmon-native-candidate-fakesmi.service

[Service]
ExecStart=/usr/lib/platmon-candidate/platmon-native serve /etc/platmon-candidate/platmon.ini --web /usr/share/platmon/frontends/web --app-version 1.3.0
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5
